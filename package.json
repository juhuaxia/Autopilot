{
  "name": "@fkqfkq123/opencode-autopilot",
  "private": false,
  "version": "0.2.4",
  "description": "An OpenCode plugin for attached-session workflow execution with refinement, planning, development, review, and test phases.",
  "author": "juhuaxia",
  "license": "MIT",
  "homepage": "https://github.com/juhuaxia/Autopilot#readme",
  "bugs": {
    "url": "https://github.com/juhuaxia/Autopilot/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juhuaxia/Autopilot.git"
  },
  "type": "module",
  "packageManager": "bun@1.3.5",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/plugin.js",
  "module": "./dist/plugin.js",
  "types": "./dist/plugin.d.ts",
  "exports": {
    ".": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js"
    },
    "./cli": {
      "types": "./dist/src/cli.d.ts",
      "import": "./dist/src/cli.js"
    },
    "./runtime": {
      "types": "./dist/packages/runtime/src/index.d.ts",
      "import": "./dist/packages/runtime/src/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "GUIDE.zh-CN.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rm -rf dist release",
    "build": "bun run clean && tsc -p tsconfig.build.json",
    "build:release": "bun run scripts/build-release.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "cli": "bun run src/cli.ts",
    "pack:dry-run": "npm pack --dry-run",
    "smoke:plugin": "bun run scripts/plugin-smoke-test.ts",
    "smoke:install": "bun run scripts/install-smoke-test.ts",
    "prepublishOnly": "bun run typecheck && bun test && bun run build"
  },
  "devDependencies": {
    "@types/bun": "1.3.4",
    "@types/node": "22.13.9",
    "typescript": "5.8.2"
  },
  "dependencies": {
    "zod": "4.1.8"
  },
  "keywords": [
    "workflow",
    "opencode",
    "plugin",
    "agent",
    "harness"
  ]
}
